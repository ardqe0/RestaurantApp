# Copy this file to .env before running Docker Compose.
# Never commit the resulting .env file.

APP_PORT=5223
ALLOWED_HOSTS=localhost;127.0.0.1

# SQL Server requires a strong password.
MSSQL_SA_PASSWORD=Replace-With-A-Strong-Password-123!

# Use a random value containing at least 32 characters.
JWT_KEY=Replace-With-A-Random-JWT-Key-At-Least-32-Characters

# Optional bootstrap accounts. Leave all four values empty to create no staff users.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_KITCHEN_USERNAME=
BOOTSTRAP_KITCHEN_PASSWORD=
